# Copy to web/.env.local. Local values come from `npx supabase status -o env`
# (API_URL and PUBLISHABLE_KEY). For production, use the Supabase project's URL
# and publishable (anon) key. Never put the secret/service-role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
